@export("SKIP_getArraySize")
fun getArraySize(arr: Array<Array<Int>>): UInt32 {
  UInt32::truncate(arr.size())
}

@export("SKIP_createByteArray")
fun createByteArray(size: UInt32): mutable Array<UInt8> {
  Array<UInt8>::mfill(size.toInt(), UInt8::truncate(0));
}

@export("SKIP_createFloatArray")
fun createFloatArray(size: UInt32): mutable Array<Float> {
  Array<Float>::mfill(size.toInt(), 0.0);
}

@export("SKIP_createUInt32Array")
fun createUInt32Array(size: UInt32): mutable Array<UInt32> {
  Array<UInt32>::mfill(size.toInt(), UInt32::truncate(0));
}

@export("SKIP_createIntArray")
fun createIntArray(size: Int): mutable Array<Int> {
  Array<Int>::mfill(size, 0);
}

module OCaml;

value class Value(Array<UInt32>)

@export("SKIP_ocamlCreateContext")
fun createContext(): mutable SKStore.Context {
  mutable SKStore.Context{}
}

class Key(value: String) extends SKStore.Key
class File(value: Value) extends SKStore.File

@export("SKIP_ocamlCreateDirName")
fun createDirName(str: String): SKStore.DirName {
  SKStore.DirName::create(str)
}

@export("SKIP_ocamlCreateInputDir")
fun createInputDir(
  context: mutable SKStore.Context,
  dirName: SKStore.DirName,
): void {
  context.unsafeMaybeGetEagerDir(dirName) match {
  | None() -> _ = context.mkdir(Key::keyType, File::type, dirName)
  | Some _ -> void
  }
}

@export("SKIP_ocamlWrite")
fun write(
  context: mutable SKStore.Context,
  dirName: SKStore.DirName,
  key: String,
  value: Value,
): void {
  context
    .unsafeGetEagerDir(dirName)
    .writeArray(context, Key(key), Array[File(value)]);
}

@export("SKIP_ocamlUnsafeGetArray")
fun unsafeGetArray(
  context: mutable SKStore.Context,
  dirName: SKStore.DirName,
  key: String,
): Array<Value> {
  context.unsafeGetEagerDir(dirName).getArrayRaw(Key(key)).map(value -> {
    value match {
    | File(v) -> v
    | _ -> invariant_violation("Unexpected value")
    }
  })
}

@export("SKIP_ocamlArrayValueSize")
fun arrayValueSize(arr: Array<Value>): Int {
  arr.size()
}

@cpp_extern("SKIP_saveDelayedCall")
native fun saveDelayedCall(
  dirName: String,
  key: String,
  values: Array<Value>,
): void;

@export("SKIP_ocamlDelayedMap")
fun delayedMap(
  context: mutable SKStore.Context,
  parentDirName: SKStore.DirName,
  targetDirName: SKStore.DirName,
): void {
  handle = SKStore.EHandle(Key::keyType, File::type, parentDirName);
  _ = handle.map(
    Key::keyType,
    File::type,
    context,
    targetDirName,
    (_context, _writer, key, valueIter) ~> {
      saveDelayedCall(
        parentDirName.toString(),
        key.value,
        valueIter.nonEmptyMap(x -> x.value).toArray(),
      );
    },
  )
}

module end;
